{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lean/logos",
	"title": "Logo strip",
	"category": "lean",
	"icon": "awards",
	"description": "Client or partner logos as a grid or a CSS-only marquee. Logos without an image are shown as text.",
	"keywords": [ "partners", "clients", "brands", "marquee" ],
	"textdomain": "lean-block-theme",
	"attributes": {
		"align": { "type": "string", "default": "full" },
		"eyebrow": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "Trusted by teams at" },
		"titleTag": { "type": "string", "enum": [ "h2", "h3", "h4", "none" ], "default": "h2" },
		"layout": { "type": "string", "enum": [ "grid", "marquee" ], "default": "grid" },
		"grayscale": { "type": "boolean", "default": true },
		"items": {
			"type": "array",
			"default": [
				{ "name": "Company one", "url": "", "imageId": 0 },
				{ "name": "Company two", "url": "", "imageId": 0 },
				{ "name": "Company three", "url": "", "imageId": 0 }
			],
			"items": {
				"type": "object",
				"properties": {
					"name": { "type": "string" },
					"url": { "type": "string" },
					"imageId": { "type": "integer" }
				}
			}
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"anchor": true,
		"color": { "background": true, "text": true },
		"spacing": { "margin": [ "top", "bottom" ], "padding": [ "top", "bottom" ] }
	},
	"editorScript": "file:./editor.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
